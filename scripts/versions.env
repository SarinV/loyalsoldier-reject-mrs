# Update these values only after reviewing an official MetaCubeX/mihomo release.
MIHOMO_VERSION="v1.19.28"
MIHOMO_ASSET="mihomo-linux-amd64-compatible-v1.19.28.gz"
MIHOMO_ASSET_SHA256="70d01cfb8cb7bf7a92fd1af16cb4b9553d90bb4eecde3b5c4849103e27c80ddb"
MIHOMO_RELEASE_URL="https://github.com/MetaCubeX/mihomo/releases/download/${MIHOMO_VERSION}/${MIHOMO_ASSET}"

RULESETS="reject direct proxy"

# Each provider has independent guards because their valid sizes differ by
# almost an order of magnitude. The limits leave room for normal upstream
# growth or shrinkage while rejecting empty, truncated, or wrong downloads.
REJECT_SOURCE_URL="https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/reject.txt"
REJECT_MIN_SOURCE_BYTES="1000000"
REJECT_MAX_SOURCE_BYTES="16777216"
REJECT_MIN_RULES="150000"
REJECT_MIN_MRS_BYTES="100000"

DIRECT_SOURCE_URL="https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt"
DIRECT_MIN_SOURCE_BYTES="1000000"
DIRECT_MAX_SOURCE_BYTES="8388608"
DIRECT_MIN_RULES="100000"
DIRECT_MIN_MRS_BYTES="50000"

PROXY_SOURCE_URL="https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt"
PROXY_MIN_SOURCE_BYTES="262144"
PROXY_MAX_SOURCE_BYTES="4194304"
PROXY_MIN_RULES="20000"
PROXY_MIN_MRS_BYTES="10000"
